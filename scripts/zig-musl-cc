#!/bin/sh
# zig as the x86_64 musl C compiler/linker for `make musl` when musl-gcc is absent.
# cc-rs passes `--target=x86_64-unknown-linux-musl`, which zig cannot parse; drop
# it and pin zig's own target spelling instead.
set -e
args=""
for a in "$@"; do
  case "$a" in
    --target=*) ;;
    *) args="$args \"$(printf '%s' "$a" | sed 's/"/\\"/g')\"" ;;
  esac
done
eval exec zig cc -target x86_64-linux-musl $args
